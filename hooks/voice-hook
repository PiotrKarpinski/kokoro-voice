#!/bin/sh
# UserPromptSubmit hook. Carries the voice mode into every turn, plus the live
# speech position while something is playing. The mode lives in config.json
# (kokoro --set mode=...). Rules that must hold go HERE: sessions often act on
# this text without loading the skill.
K="${KOKORO_HOME:-$HOME/.kokoro}"

MODE=$(KOKORO_STATE="$K" python3 - <<'PY'
import json, os, pathlib
k = pathlib.Path(os.environ["KOKORO_STATE"])
try:
    cfg = json.loads((k/"config.json").read_text())
except Exception:
    cfg = {}
mode = cfg.get("mode")
if mode is None:
    mode = "narrate" if (k/".narrate").exists() else "on-request"
print(mode)
PY
)

case "$MODE" in
on-request)
cat <<'TXT'
<voice mode="on-request">
Voice is available through the `voice` skill (command: `kokoro`). Speak only when
the user asks to hear something. Otherwise answer normally in text.
</voice>
TXT
;;
narrate)
cat <<'TXT'
<voice mode="narrate">
Voice mode is NARRATE. Follow the `voice` skill. The rules that must hold:

- Speak short progress beats as you work: `kokoro --bg --title "<subject>" "<beat>"`.
  Three to eight words each, three to eight per task, at meaningful steps only.
  Always --bg; plain `kokoro` blocks the work.
- When the task is done, queue ONE spoken summary the same way, 100-180 words,
  written for the ear.
- NEVER speak a filename, path, extension, code, command or flag. "player dot g d"
  is nonsense aloud. Say what the file does: "the player movement script".
- Answer in the chat exactly as normal. Narration is an extra channel. Do not also
  paste the spoken summary into the chat.
- Trivial one-line answers need no narration at all.
</voice>
TXT
;;
esac

[ -f "$K/.now-playing" ] || exit 0
KOKORO_STATE="$K" python3 - <<'PY'
import json, os, pathlib, time, sys
k = pathlib.Path(os.environ["KOKORO_STATE"])
try:
    st = json.loads((k/".now-playing").read_text())
except Exception:
    sys.exit(0)
if not (k/".paused").exists() and time.time() - st.get("at", 0) > 120:
    sys.exit(0)             # stale - but a paused position is still exactly where they are
s, i = st["sentences"], st["index"]
print("<speaking-now>")
print(f"You are speaking aloud RIGHT NOW - sentence {i+1} of {st['total']}.")
print("The user is hearing this as they type. What they just heard:")
for n, line in enumerate(s[max(0, i-3): i+1], start=max(0, i-3)):
    print(f"  {'>>' if n == i else '  '} {line}")
if (k/".paused").exists():
    print("Playback is currently PAUSED.")
print("""
Their message may be about what they are hearing - slow down, go back, explain,
stop. It may equally be unrelated. Judge it; do not pattern match on words.

If it IS about the audio: run `kokoro --pause` FIRST, before anything else. Answer
in the chat as text. Then `kokoro --resume`, or `kokoro --hush` if they have moved
on. `kokoro --where` gives more context.

If it is NOT about the audio, ignore this block and let it play.
</speaking-now>""")
PY
